# Server Configuration
PORT=8080
GIN_MODE=debug

# Redis Configuration
REDIS_URL=redis://localhost:6379

# MongoDB 持久层 (为空则降级为纯 Redis 缓存模式，每次回源豆瓣)
MONGO_URI=
MONGO_DB_NAME=kerkerker_douban

# Douban Proxy (多个代理用逗号分隔)
DOUBAN_API_PROXY=

# TMDB API (用于 Hero Banner 横向海报，多个 API Key 用逗号分隔，启用轮询)
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/original

# Cloudflare R2 (推荐使用绑定到 Bucket 的自定义域名)
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_UPLOAD_API_URL=
CLOUDFLARE_R2_UPLOAD_API_TOKEN=
CLOUDFLARE_R2_KEY_PREFIX=douban-images
CLOUDFLARE_R2_MAX_IMAGE_BYTES=10485760

# 直接使用 R2 S3 API 上传（与 Upload Worker 二选一）
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# Cache TTL (单位：分钟)
CACHE_TTL_HERO=360       # Hero Banner 缓存时间，默认 6 小时
CACHE_TTL_DETAIL=1440    # 详情页缓存时间，默认 24 小时
CACHE_TTL_CATEGORY=60    # 分类缓存时间，默认 1 小时
CACHE_TTL_SEARCH=30      # 搜索缓存时间，默认 30 分钟
CACHE_TTL_DEFAULT=60     # 默认缓存时间，默认 1 小时

# Admin API 认证 (为空则不启用认证，管理接口对外开放)
ADMIN_API_KEY=
